
      CREATE TABLE IF NOT EXISTS account_table (
        id          INTEGER PRIMARY KEY AUTOINCREMENT,
        username    TEXT UNIQUE,
        cookie      TEXT,
        is_active   INTEGER DEFAULT 0,
        create_time INTEGER,
        update_time INTEGER,
        nickname    TEXT DEFAULT '',
        avatar_url  TEXT DEFAULT ''
      );
    

