{
  "apiType": "stageMode",
  "buildOption": {
    "resOptions": {
      "copyCodeResource": {
        "enable": false
      }
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    }
  ],
  "targets": [
  {
    "name": "default",
    "config": {
      "buildOption": {
        "arkOptions": {
          "buildProfileFields": {
            "IS_MOCK": "false"
          }
        }
      }
    }
  },
  {
    "name": "mock",
    "config": {
      "buildOption": {
        "arkOptions": {
          "buildProfileFields": {
            "IS_MOCK": "true"
          }
        }
      }
    }
  }
]
}
