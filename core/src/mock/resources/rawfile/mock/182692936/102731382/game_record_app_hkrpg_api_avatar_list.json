        "element": "imaginary",
        "icon": "https://act-webstatic.mihoyo.com/darkmatter/hkrpg/prod_gf_cn/item_icon_u7f11d/2107fd5c5d980c4863e952e14fe5b684.png",
        "rarity": 5,
