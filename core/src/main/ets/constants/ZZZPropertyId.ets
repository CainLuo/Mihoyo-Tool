/**
 * ZZZPropertyId — 绝区零属性 ID 枚举
 *
 * 对应米游社 API 中 property_id 字段的所有已知值。
 * 用于驱动盘词条、代理人属性面板的统一映射，
 * 禁止在业务代码中直接写 property_id 数字字面量。
 *
 * 数据来源：event/game_record_zzz/api/zzz/avatar/info 接口
 * 响应体中 equip[].properties 和 equip[].main_properties 的 property_id 字段。
 *
 * 命名规则：system_id 前两位表示属性大类，后一位表示词条等级（1=基础，2=中级，3=高级）。
 * 例如：11103 = 生命值(111) 高级词条(3)；21103 = 暴击伤害(211) 高级词条(3)。
 *
 * 注意：绝区零使用 property_id（5位数），与原神/星铁的 property_type（1-2位数）完全不同。
 */
export enum ZZZPropertyId {
  // ── 生命值（system_id: 111）──────────────────────────────────────

  /** 生命值（基础，固定值，如 "2200"） */
  HP_BASE = 11101,

  /** 生命值（中级，固定值） */
  HP_MID = 11102,

  /** 生命值（高级，固定值，如 "224"） */
  HP_HIGH = 11103,

  // ── 攻击力（system_id: 121）──────────────────────────────────────

  /** 攻击力（基础，固定值） */
  ATK_BASE = 12101,

  /** 攻击力（中级，固定值） */
  ATK_MID = 12102,

  /** 攻击力（高级，固定值） */
  ATK_HIGH = 12103,

  // ── 防御力（system_id: 131）──────────────────────────────────────

  /** 防御力（基础，百分比，如 "14.4%"） */
  DEF_BASE = 13101,

  /** 防御力（中级，百分比） */
  DEF_MID = 13102,

  /** 防御力（高级，百分比） */
  DEF_HIGH = 13103,

  // ── 暴击率（system_id: 211）──────────────────────────────────────

  /** 暴击率（基础，百分比） */
  CRIT_RATE_BASE = 21101,

  /** 暴击率（中级，百分比） */
  CRIT_RATE_MID = 21102,

  /** 暴击率（高级，百分比） */
  CRIT_RATE_HIGH = 21103,

  // ── 暴击伤害（system_id: 211，注意与暴击率共用 system_id 前缀）──

  /** 暴击伤害（基础，百分比） */
  CRIT_DMG_BASE = 21101,

  /** 暴击伤害（中级，百分比，如 "4.8%"） */
  CRIT_DMG_MID = 21102,

  /** 暴击伤害（高级，百分比，如 "9.6%"） */
  CRIT_DMG_HIGH = 21103,

  // ── 穿透值（system_id: 232）──────────────────────────────────────

  /** 穿透值（基础，固定值） */
  PEN_BASE = 23201,

  /** 穿透值（中级，固定值） */
  PEN_MID = 23202,

  /** 穿透值（高级，固定值，如 "9"） */
  PEN_HIGH = 23203,

  // ── 异常精通（system_id: 312）────────────────────────────────────

  /** 异常精通（基础，固定值） */
  ANOMALY_MASTERY_BASE = 31201,

  /** 异常精通（中级，固定值） */
  ANOMALY_MASTERY_MID = 31202,

  /** 异常精通（高级，固定值，如 "27"） */
  ANOMALY_MASTERY_HIGH = 31203,
}
