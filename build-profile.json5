{
  app: {
    signingConfigs: [
      {
        name: "release",
        type: "HarmonyOS",
        material: {
          certpath: "/Users/cain/DevEcoStudioProjects/Mihoyo-Tool/Certificates/release/miyoyo.cer",
          keyAlias: "Miyoyo",
          keyPassword: "0000001F2FDC29265EB573331B7785E902AEE2C6A361A1C63C7B096986025FAEA9B3EB535986344BA64B555FC8715B",
          profile: "/Users/cain/DevEcoStudioProjects/Mihoyo-Tool/Certificates/release/miyoyoRelease.p7b",
          signAlg: "SHA256withECDSA",
          storeFile: "/Users/cain/DevEcoStudioProjects/Mihoyo-Tool/Certificates/Miyoyo.p12",
