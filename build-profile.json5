        },
      },
      // UAT / Mock 在模拟器上使用 unsigned HAP；如需真机安装，再为对应包名配置 p7b。
      // 一套 p7b 只能对应一个 bundleName，不能复用给多个后缀包名。
    ],
    products: [
      // default 是 Hvigor / DevEco 要求的技术兜底产品，不是第四个运行环境。
      // 实际发布使用 release product；两者使用相同的 release 包名和签名。
      {
        name: "default",
        signingConfig: "release",
        bundleName: "com.cainluo.miyoyo.tools",
        targetSdkVersion: "6.0.2(22)",
        compatibleSdkVersion: "6.0.2(22)",
        runtimeOS: "HarmonyOS",
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
          arkOptions: {
            buildProfileFields: {
              APP_ENV: "release",
            },
          },
        },
      },
      {
        name: "release",
        signingConfig: "release",
        bundleName: "com.cainluo.miyoyo.tools",
        label: "$string:app_name_release",
        targetSdkVersion: "6.0.2(22)",
        compatibleSdkVersion: "6.0.2(22)",
        runtimeOS: "HarmonyOS",
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
          arkOptions: {
            buildProfileFields: {
              APP_ENV: "release",
            },
          },
        },
      },
      {
        name: "uat",
        bundleName: "com.cainluo.miyoyo.tools.uat",
        label: "$string:app_name_uat",
        targetSdkVersion: "6.0.2(22)",
        compatibleSdkVersion: "6.0.2(22)",
        runtimeOS: "HarmonyOS",
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
          arkOptions: {
            buildProfileFields: {
              APP_ENV: "uat",
            },
          },
        },
      },
      {
        name: "mock",
        bundleName: "com.cainluo.miyoyo.tools.mock",
        label: "$string:app_name_mock",
        targetSdkVersion: "6.0.2(22)",
        compatibleSdkVersion: "6.0.2(22)",
        runtimeOS: "HarmonyOS",
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
          arkOptions: {
            buildProfileFields: {
              APP_ENV: "mock",
            },
          },
        },
      },
    ],
    buildModeSet: [
      {
        name: "debug",
      },
      {
        name: "release",
      },
    ],
  },
  modules: [
    {
      name: "entry",
      srcPath: "./entry",
      targets: [
        {
          name: "default",
          applyToProducts: ["default"],
        },
        {
          name: "release",
          applyToProducts: ["release"],
        },
        {
          name: "uat",
